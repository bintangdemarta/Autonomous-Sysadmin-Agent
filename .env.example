# SSH target used by both CLI and web app. No secrets should be committed.
NEXUS_SSH_HOST=your-server.example.com
NEXUS_SSH_PORT=22
NEXUS_SSH_USER=your-ssh-user
# Choose one authentication method:
NEXUS_SSH_PASSWORD=
NEXUS_SSH_KEY_PATH=/home/you/.ssh/id_ed25519
NEXUS_SSH_TIMEOUT=15

# Optional web Basic Auth. If unset, auth is disabled for local development only.
NEXUS_WEB_USERNAME=admin
NEXUS_WEB_PASSWORD=change-me

# Optional paths.
NEXUS_COMMANDS_PATH=config/commands.json
NEXUS_AUDIT_LOG_PATH=data/audit_log.jsonl
