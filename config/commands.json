{
  "monitoring": [
    {
      "name": "Check RAM",
      "command": "free -h",
      "keywords": ["cek ram", "ram", "memory", "cek memory", "cek memori", "memori"],
      "description": "Displays system memory usage",
      "risk_level": "low"
    },
    {
      "name": "Check Disk",
      "command": "df -h",
      "keywords": ["cek disk", "disk", "storage", "cek storage", "cek penyimpanan", "penyimpanan"],
      "description": "Displays disk space usage",
      "risk_level": "low"
    },
    {
      "name": "Check Uptime",
      "command": "uptime",
      "keywords": ["cek uptime", "uptime", "waktu hidup", "cek waktu hidup"],
      "description": "Displays system uptime and load averages",
      "risk_level": "low"
    },
    {
      "name": "Check CPU Info",
      "command": "lscpu",
      "keywords": ["cek cpu", "cpu", "cek processor", "processor", "cek prosesor", "prosesor"],
      "description": "Displays CPU information",
      "risk_level": "low"
    },
    {
      "name": "Check Network Stats",
      "command": "netstat -tuln",
      "keywords": ["cek network", "network", "cek jaringan", "jaringan", "cek koneksi", "koneksi"],
      "description": "Displays network connections and listening ports",
      "risk_level": "low"
    }
  ],
  "processes": [
    {
      "name": "List Processes",
      "command": "ps aux",
      "keywords": ["cek proses", "proses", "cek process", "process", "cek aktifitas", "aktifitas"],
      "description": "Displays all running processes",
      "risk_level": "low"
    },
    {
      "name": "Top Processes",
      "command": "top -bn1",
      "keywords": ["cek top", "top", "cek proses berat", "proses berat"],
      "description": "Displays top resource-consuming processes",
      "risk_level": "low"
    }
  ],
  "users": [
    {
      "name": "List Users",
      "command": "who",
      "keywords": ["cek user", "user", "cek pengguna", "pengguna", "cek siapa saja", "siapa saja"],
      "description": "Displays currently logged in users",
      "risk_level": "low"
    }
  ],
  "proxmox": [
    {
      "name": "Start Proxmox VM",
      "pattern": "hidupkan vm (\\d+)",
      "command": "qm start {0}",
      "description": "Start a Proxmox virtual machine by VM ID",
      "risk_level": "high",
      "requires_confirmation": true
    },
    {
      "name": "Shutdown Proxmox VM",
      "pattern": "matikan vm (\\d+)",
      "command": "qm shutdown {0}",
      "description": "Gracefully shut down a Proxmox virtual machine by VM ID",
      "risk_level": "high",
      "requires_confirmation": true
    }
  ]
}
